# The LMS integration package is scoped @ubc and published to GitHub Packages,
# not the public registry. This line is a registry URL, not a credential.
#
# Your PAT (classic, read:packages) belongs in ~/.npmrc, never here:
#   npm config set //npm.pkg.github.com/:_authToken=YOUR_TOKEN --location=user
@ubc:registry=https://npm.pkg.github.com
